# Sentinel AI Backend Environment Variables

DATABASE_URL=postgresql+psycopg://sentinel_user:sentinel_password@localhost:5432/sentinel_ai

# Password Hashing
#
# Argon2id password hashing parameters.
# Override only through reviewed deployment configuration.

PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_PARALLELISM=4
PASSWORD_HASH_HASH_LEN=32
PASSWORD_HASH_SALT_LEN=16
